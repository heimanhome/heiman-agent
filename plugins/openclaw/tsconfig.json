{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@openclaw/plugin-sdk": ["src/mock/plugin-sdk.ts"]
    }
  },
  "include": ["src/**/*", "openclaw.plugin.json"],
  "exclude": ["node_modules", "dist", "tests"]
}